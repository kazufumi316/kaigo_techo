<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-8">
    <h1>要介護家族追加</h1>
  </div>
  
  <%= form_with url: connect_care_users_path, local: true do |f| %>

    <div class="w-full max-w-md text-3xl text-gray-700">
      <div class="field mb-5">
        <p class="font-bold mb-4">コードを入力してください</p>
        <p><%= f.text_field :invite_code, class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>
    </div>

    <div class="flex flex-col justify-center items-center mt-4 gap-4">
        <div class="actions w-full">
          <%= f.submit "登録", class: "w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg cursor-pointer" %>
          <%= link_to "戻る", care_users_path, class: "mt-4 w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg cursor-pointer" %>
        </div>
      </div>
  <% end %>
</div>