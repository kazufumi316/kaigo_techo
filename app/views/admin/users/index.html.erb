<h1 class="text-2xl font-bold mb-6">ユーザー一覧</h1>

<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-gray-50 text-left text-gray-500">
      <tr>
        <th class="px-4 py-3"><%= User.human_attribute_name(:name) %></th>
        <th class="px-4 py-3"><%= User.human_attribute_name(:tel_number) %></th>
        <th class="px-4 py-3"><%= User.human_attribute_name(:email) %></th>
        <th class="px-4 py-3">権限</th>
        <th class="px-4 py-3">登録日</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3"><%= link_to user.name, admin_user_path(user), class: "text-blue-600 hover:underline" %></td>
          <td class="px-4 py-3"><%= user.tel_number %></td>
          <td class="px-4 py-3"><%= user.email %></td>
          <td class="px-4 py-3"><%= user.admin? ? "管理者" : "一般" %></td>
          <td class="px-4 py-3"><%= user.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6">
  <%= paginate @users %>
</div>
