<h1 class="text-2xl font-bold mb-6">見守り家族詳細</h1>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <dt class="text-sm text-gray-500">氏名</dt>
      <dd class="text-lg"><%= @care_user.name %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">生年月日</dt>
      <dd class="text-lg"><%= @care_user.birthday.strftime("%Y年%-m月%-d日") %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">血液型</dt>
      <dd class="text-lg"><%= @care_user.blood_type %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">登録日</dt>
      <dd class="text-lg"><%= @care_user.created_at.strftime("%Y/%m/%d") %></dd>
    </div>
    <div class="sm:col-span-2">
      <dt class="text-sm text-gray-500">病名</dt>
      <dd class="text-lg">
        <%= [ @care_user.medical_condition_1, @care_user.medical_condition_2, @care_user.medical_condition_3 ].compact_blank.join("、").presence || "登録なし" %>
      </dd>
    </div>
  </dl>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <h2 class="text-lg font-bold mb-4">紐づいているユーザー</h2>
  <% if @users.any? %>
    <ul class="divide-y">
      <% @users.each do |user| %>
        <li class="py-2">
          <%= link_to user.name, admin_user_path(user), class: "text-blue-600 hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">紐づいているユーザーはいません</p>
  <% end %>
</div>

<div class="flex items-center gap-4">
  <%= link_to "一覧に戻る", admin_care_users_path, class: "px-6 py-3 bg-gray-500 hover:bg-gray-400 text-white font-bold rounded-lg" %>

  <%= button_to "見守り家族削除", admin_care_user_path(@care_user),
                data: { turbo_confirm: "本当に削除しますか?\n この見守り家族の介護記録も\n 削除されますがよろしいですか?" },
                method: :delete,
                class: "px-6 py-3 bg-red-500 hover:bg-red-400 text-white font-bold rounded-lg" %>
</div>
