<h1 class="text-2xl font-bold mb-6">見守り家族一覧</h1>

<%= form_with url: admin_care_users_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= text_field_tag :name, params[:name], placeholder: "名前で検索", class: "border border-gray-300 rounded px-3 py-2 flex-1" %>
  <%= submit_tag "検索", class: "px-4 py-2 bg-blue-500 hover:bg-blue-400 text-white font-bold rounded" %>
<% end %>

<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-gray-50 text-left text-gray-500">
      <tr>
        <th class="px-4 py-3">氏名</th>
        <th class="px-4 py-3">生年月日</th>
        <th class="px-4 py-3">血液型</th>
        <th class="px-4 py-3">紐づきユーザー</th>
        <th class="px-4 py-3">登録日</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% @care_users.each do |care_user| %>
        <tr>
          <td class="px-4 py-3"><%= link_to care_user.name, admin_care_user_path(care_user), class: "text-blue-600 hover:underline" %></td>
          <td class="px-4 py-3"><%= care_user.birthday.strftime("%Jf") %></td>
          <td class="px-4 py-3"><%= care_user.blood_type %></td>
          <td class="px-4 py-3">
            <% if care_user.family.family_members.empty? %>
              <span class="inline-block px-2 py-1 text-xs font-bold text-red-600 bg-red-100 rounded">未紐づき</span>
            <% else %>
              <%= care_user.family.family_members.size %>人
            <% end %>
          </td>
          <td class="px-4 py-3"><%= care_user.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6">
  <%= paginate @care_users %>
</div>
