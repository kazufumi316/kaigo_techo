<h1 class="text-2xl font-bold mb-6">見守り家族一覧</h1>

<div class="bg-white rounded-lg shadow overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-gray-50 text-left text-gray-500">
      <tr>
        <th class="px-4 py-3">氏名</th>
        <th class="px-4 py-3">生年月日</th>
        <th class="px-4 py-3">血液型</th>
        <th class="px-4 py-3">登録日</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% @care_users.each do |care_user| %>
        <tr>
          <td class="px-4 py-3"><%= link_to care_user.name, admin_care_user_path(care_user), class: "text-blue-600 hover:underline" %></td>
          <td class="px-4 py-3"><%= care_user.birthday.strftime("%Y/%m/%d") %></td>
          <td class="px-4 py-3"><%= care_user.blood_type %></td>
          <td class="px-4 py-3"><%= care_user.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6">
  <%= paginate @care_users %>
</div>
