<h1 class="text-2xl font-bold mb-6">ダッシュボード</h1>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div class="bg-white rounded-lg shadow p-6 text-center">
    <p class="text-sm text-gray-500">ユーザー数</p>
    <p class="text-3xl font-bold"><%= @user_count %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-6 text-center">
    <p class="text-sm text-gray-500">見守り家族数</p>
    <p class="text-3xl font-bold"><%= @care_user_count %></p>
  </div>
  <div class="bg-white rounded-lg shadow p-6 text-center">
    <p class="text-sm text-gray-500">介護記録数</p>
    <p class="text-3xl font-bold"><%= @care_record_count %></p>
  </div>
</div>
