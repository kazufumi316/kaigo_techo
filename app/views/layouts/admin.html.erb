<!DOCTYPE html>
<html>
  <head>
    <title>管理画面 | おやこうこうかん日記</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= favicon_link_tag "icon.png" %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <header class="bg-gray-800 text-white">
      <nav class="max-w-5xl mx-auto flex justify-between items-center h-16 px-4">
        <div class="hidden sm:flex items-center gap-6">
          <%= link_to "管理画面", admin_root_path, class: "font-bold" %>
          <%= link_to "ユーザー", admin_users_path, class: "text-gray-300 hover:text-white" %>
          <%= link_to "見守り家族", admin_care_users_path, class: "text-gray-300 hover:text-white" %>
          <%= link_to "介護記録", admin_care_records_path, class: "text-gray-300 hover:text-white" %>
        </div>

        <span class="font-bold sm:hidden">管理画面</span>

        <div class="hidden sm:flex items-center gap-4">
          <%= link_to "ホーム", homes_path, class: "text-gray-300 hover:text-white" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "text-sm bg-gray-600 hover:bg-gray-500 px-4 py-2 rounded" %>
        </div>

        <details class="sm:hidden relative">
          <summary class="list-none cursor-pointer p-2 [&::-webkit-details-marker]:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-1 w-48 bg-gray-800 rounded shadow-lg py-2 z-10">
            <%= link_to "管理画面", admin_root_path, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" %>
            <%= link_to "ユーザー", admin_users_path, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" %>
            <%= link_to "見守り家族", admin_care_users_path, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" %>
            <%= link_to "介護記録", admin_care_records_path, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" %>
            <%= link_to "ホーム", homes_path, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" %>
            <div class="border-t border-gray-700 my-1"></div>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" %>
          </div>
        </details>
      </nav>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <% if flash.any? %>
        <div class="mb-4">
          <% flash.each do |type, message| %>
            <div class="<%= type.to_s == "notice" ? "text-green-600" : "text-red-600" %> font-bold whitespace-pre-line"><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
