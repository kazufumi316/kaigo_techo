<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl text-center font-bold">
    <h1>パスワード再設定</h1>
  </div>

  <div class="w-full max-w-md text-3xl text-gray-700">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field mt-4 mb-5">
       <p class="font-bold mb-1"><%= f.label :password, "新しいパスワード" %></p>
        <% if @minimum_password_length %>
          <p class="text-lg text-gray-500 mb-1"><em>(6文字以上で入力してください)</em></p>
        <% end %>
        <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>


      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :password_confirmation, "新しいパスワード（確認用）" %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="flex flex-col justify-center items-center mt-8 gap-4">
        <div class="actions w-full">
          <%= f.submit "再登録", class: "mb-10 w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <div class="text-center mt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
