<h2>アカウント新規登録ページ</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :氏名 %></p>
    <p><%= f.text_field :name%></p>
  </div>

  <div class="field">
    <p><%= f.label :メールアドレス %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

    <div class="field">
    <p><%= f.label :電話番号 %></p>
    <p><%= f.telephone_field :tel_number %></p>
  </div>

  <div class="field">
    <p><%= f.label :パスワード %></p>
    <% if @minimum_password_length %>
      <p><em>(6文字以上で入力してください)</em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :パスワード確認 %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "登録" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
