<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold">
    <h1>新規登録ページ</h1>
  </div>
  
  <div class="w-full max-w-md text-3xl text-gray-700">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :name %></p>
        <p><%= f.text_field :name, autocomplete: "name", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :tel_number %></p>
        <p><%= f.telephone_field :tel_number, autocomplete: "telephone", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :email %></p>
        <p><%= f.email_field :email, autocomplete: "email", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :password %></p>
          <% if @minimum_password_length %>
            <p class="text-lg text-gray-500 mb-1"><em>(6文字以上で入力してください)</em></p>
          <% end %>
        <p><%= f.password_field :password, autocomplete: "new-password", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :password_confirmation %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="flex flex-col justify-center items-center mt-8 gap-4">
        <div class="actions w-full">
          <%= f.submit "登録", class: "w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg cursor-pointer" %>
        </div>
      </div>
    <% end %>
    
    <div class="text-center mt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>