<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-1">
    <h1>アカウント編集ページ</h1>
  </div>
  <div class="text-2xl font-bold mb-4">
    <h1>変更部分を入力し更新してください</h1>
  </div>
  
  <div class="w-full max-w-md text-3xl text-gray-700">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :name %></p>
        <p><%= f.text_field :name, autofocus: true, autocomplete: "name", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :tel_number %></p>
        <p><%= f.telephone_field :tel_number, autofocus: true, autocomplete: "telephone", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :email %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :新しいパスワード %></p>
        <% if @minimum_password_length %>
            <p class="text-lg text-gray-500 mb-1"><em>(6文字以上で入力してください)</em></p>
        <% end %>
        <p><%= f.password_field :password, autocomplete: "new-password", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="field mb-5">
        <p class="font-bold mb-1"><%= f.label :password_confirmation %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
      </div>

      <div class="flex flex-col justify-center items-center mt-8 gap-4">
        <div class="actions w-full">
          <%= f.submit "更新", class: "w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg cursor-pointer" %>
        </div>
      </div>
    <% end %>

<h3>Cancel my account</h3>

<div>Unhappy? <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>

<%= link_to "Back", :back %>
