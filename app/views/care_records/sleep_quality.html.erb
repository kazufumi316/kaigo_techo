<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-8">
    <h1>睡眠はどうでしたか？</h1>
  </div>

  <%= form_with model: @care_record, url: save_sleep_quality_care_records_path, method: :patch, local: true do |f| %>
    <div class="w-75 grid grid-cols-1 gap-4 max-w-2xl">
      <% CareRecord.sleep_qualities.keys.each do |sleep_quality| %>
        <%= f.button sleep_quality,
              type: "submit",
              name: "care_record[sleep_quality]",
              value: sleep_quality,
              class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 max-w-2xl">
    <%= link_to "戻る", appetite_care_records_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg" %>
  </div>
</div>