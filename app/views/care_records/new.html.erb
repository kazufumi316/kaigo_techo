<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-8">
    <h1>要介護家族選択</h1>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
    <% if @care_users.present? %>
      <% @care_users.each do |care_user| %>
        <%= link_to care_user.name, "#", class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
      <% end %>
    <% else %>
      <div class="col-span-full text-center text-4xl mb-5 font-bold">要介護家族がいません</div>
    <% end %>
  </div>

  <div class="text-4xl font-bold mb-8 mt-4">
    <h1>体調</h1>
  </div>
  <div class="grid grid-cols-3 gap-4 max-w-2xl">
    <%= link_to "良い", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
    
    <%= link_to "普通", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  
    <%= link_to "悪い", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  </div>

  <div class="text-4xl font-bold mb-8 mt-4">
    <h1>食欲</h1>
  </div>
  <div class="grid grid-cols-3 gap-4 max-w-2xl">
    <%= link_to "ある", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
    
    <%= link_to "普通", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  
    <%= link_to "ない", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  </div>

  <div class="text-4xl font-bold mb-8 mt-4">
    <h1>睡眠</h1>
  </div>
  <div class="grid grid-cols-3 gap-4 max-w-2xl">
    <%= link_to "多い", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
    
    <%= link_to "普通", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  
    <%= link_to "少ない", "#", class: "flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  </div>

  <div class="text-4xl font-bold mb-8 mt-4">
    <h1>特記事項</h1>
  </div>
  <div class="mb-5 col-span-full bg-white w-full h-100">
    <p><%= text_area :memo, class: "w-full p-3 col-span-full border border-gray-300 rounded-lg bg-white focus:outline-orange-500" %></p>
  </div>
  <div class="flex flex-col w-full items-center justify-center gap-4 max-w-2xl">
    <%= link_to "記録する", "#", class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>

    <%= link_to "戻る", "#", class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  </div>
</div>