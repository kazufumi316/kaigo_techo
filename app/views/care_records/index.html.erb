<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold">
    <h1><%= @care_user.name %>の介護記録一覧</h1>
  </div>

  <%= render "shared/message" %>

  <div class="pagination flex items-center justify-center mt-4 gap-1">
    <%= link_to "◀️ 前月", care_records_path(care_user_id: params[:care_user_id], year: @prev_month.year, month: @prev_month.month),  class: "w-30  justify-center items-center px-5 py-3 text-2xl text-center text-white bg-sky-500 hover:bg-sky-300 font-bold rounded-lg" %>
    <%= link_to raw("#{@target_date.year}年<br>#{@target_date.month}月"), care_records_path(care_user_id: params[:care_user_id], year: @target_date.year, month: @target_date.month),  class: "w-35 justify-center items-center px-5 py-3 text-2xl text-center font-bold rounded-lg" %>
    <% if @target_date < Time.current.to_date.beginning_of_month %>
      <%= link_to "翌月 ▶️", care_records_path(care_user_id: params[:care_user_id], year: @next_month.year, month: @next_month.month), class: "w-30 justify-center items-center px-5 py-3 text-2xl text-center text-white bg-sky-500 hover:bg-sky-300 font-bold rounded-lg" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mt-4">
    <% if @reports.present? %>
      <% @reports.each do |care_record| %>
        <%= link_to care_record_path(care_record), class: "w-75 h-21 flex justify-center items-center px-10 py-6 text-2xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" do %>
          <% if @unread_care_record_ids.include?(care_record.id) %>🔵 <% end %><%= care_record.save_day.strftime('%-d日') %>
          <% if care_record.memo.present? %>
            <br>
            <%= truncate(care_record.memo, length: 8) %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="col-span-full text-center text-4xl mb-5 font-bold">介護記録はありません</div>
    <% end %>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 max-w-2xl">
    <% if @care_users.count == 1 %>
      <%= link_to "戻る", homes_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg" %>
    <% else %>
      <%= link_to "戻る", view_select_care_user_care_records_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg" %>
    <% end %>
  </div>
</div> 