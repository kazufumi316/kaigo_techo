<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-8">
    <h1>要介護家族一覧</h1>
  </div>

  <div class="flex flex-col items-center justify-center gap-4 w-full text-3xl text-gray-700">
    <% if @care_users.present? %>
      <% @care_users.each do |care_user| %>
        <%= link_to care_user.name, "#", class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
      <% end %>
    <% else %>
      <div class="field mb-5 font-bold">要介護家族の登録はありません</div>
    <% end %>

    <%= link_to "要介護家族登録", "#", class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>

    <%= link_to "戻る", homes_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-orange-300 font-bold rounded-lg" %>
  </div>
</div> 
    
