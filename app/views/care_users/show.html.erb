<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-8">
    <h1>要介護者情報</h1>
  </div>

  <div class="w-full max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">氏名</p>
      <p class="font-bold w-full p-3"><%= @care_user.name %></p>
    </div>
  </div>

  <div class="w-full max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">生年月日</p>
      <p class="font-bold w-full p-3"><%= @care_user.birthday.strftime('%Y年%-m月%-d日') %></p>
    </div>
  </div>

  <div class="w-full max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">血液型</p>
      <p class="font-bold w-full p-3"><%= @care_user.blood_type %></p>
    </div>
  </div>

  <div class="w-full max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">病名</p>
      <p class="font-bold w-full p-3"><%= @care_user.medical_condition_1 %></p>
      <p class="font-bold w-full p-3"><%= @care_user.medical_condition_2 %></p>
      <p class="font-bold w-full p-3"><%= @care_user.medical_condition_3 %></p>
    </div>
  </div>

  <% if @current_family_member&.main? %>
    <div class="w-full max-w-md text-3xl text-gray-700">
      <div class="field mb-5">
        <p class="font-bold mb-1">招待コード</p>
        <p class="font-bold w-full p-3"><%= @care_user.invite_code %></p>
      </div>
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 gap-4 max-w-2xl">
    <%= link_to "戻る", homes_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg" %>
  </div>

</div>