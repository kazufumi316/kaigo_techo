<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold mb-8">
    <h1><%= @care_user.name %>の詳細情報</h1>
  </div>

  <div class="w-full items-center max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">氏名 : <%= @care_user.name %></p>
    </div>
  </div>

  <div class="w-full items-center max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">生年月日 : <%= @care_user.birthday.strftime('%Jf') %></p>
    </div>
  </div>

  <div class="w-full items-center max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">血液型 : <%= @care_user.blood_type %></p>
    </div>
  </div>

  <div class="w-full items-center max-w-md text-3xl text-gray-700">
    <div class="field mb-5">
      <p class="font-bold mb-1">病名 :</p>
      <p class="font-bold w-full p-3"><%= @care_user.medical_condition_1 %></p>
      <p class="font-bold w-full p-3"><%= @care_user.medical_condition_2 %></p>
      <p class="font-bold w-full p-3"><%= @care_user.medical_condition_3 %></p>
    </div>
  </div>

  <% if @current_family_member&.main? %>
    <div class="w-full items-center max-w-md text-3xl text-gray-700">
      <div class="field mb-5">
        <p class="font-bold mb-1">招待コード : <%= @care_user.invite_code %></p>
      </div>
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 gap-4 max-w-2xl">
    <%= link_to "編集", edit_care_user_path, class: "w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg cursor-pointer"  %>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 max-w-2xl">
    <% if @care_users.count == 1 %>
      <%= link_to "戻る", homes_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg" %>
    <% else %>
      <%= link_to "戻る", care_users_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-gray-300 font-bold rounded-lg" %>
    <% end %>
  </div>

  <% if @current_family_member&.main? %>
    <div class="mt-15 grid grid-cols-1 gap-4 max-w-2xl">
      <%= link_to "見守り家族削除", 
                  care_user_path(@care_user), 
                  class: "w-75 mx-auto flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-red-500 hover:bg-red-300 font-bold rounded-lg cursor-pointer",
                  data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか?" }  %>
    </div>
  <% end %>
</div>