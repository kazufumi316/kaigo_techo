<div class="flex flex-col items-center justify-start min-h-screen bg-orange-50 px-4 pt-5">
  <div class="text-4xl font-bold">
    <h1>ホーム</h1>
  </div>

  <%= render "shared/message" %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mt-8">
    <%= link_to "記録をつける", create_select_care_user_care_records_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
    
    <%= link_to "記録を見る", view_select_care_user_care_records_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
  
    <%= link_to "見守り家族情報", care_users_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>
    
    <%= link_to "アカウント情報", users_show_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-orange-500 hover:bg-orange-300 font-bold rounded-lg" %>

    <%= link_to "見守り家族登録", new_care_user_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-green-500 hover:bg-green-300 font-bold rounded-lg" %>

    <%= link_to "見守り家族追加", new_connect_care_user_path, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-green-500 hover:bg-green-300 font-bold rounded-lg" %>
  </div>

  <div class="grid grid-cols-1 max-w-2xl mt-4">
    <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "w-75 flex justify-center items-center px-10 py-6 text-3xl text-center text-white bg-gray-500 hover:bg-red-500 font-bold rounded-lg" %>
  </div>
</div>